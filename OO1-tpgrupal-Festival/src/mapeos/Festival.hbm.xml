<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="modelo.Festival" table="festival">
    	<!-- ID -->
        <id name="id" column="id_festival">
            <generator class="identity"/>
        </id>
		<!-- Atributos - Columnas -->
		<property name="nombre" column="nombre" type="string" not-null="true"/>
		<property name="temporada" column="temporada" type="string" not-null="true"/>
		<property name="fechaInicio" column="fecha_inicio" type="java.time.LocalDate" not-null="true"/>
		<property name="fechaFin" column="fecha_fin" type="java.time.LocalDate" not-null="true"/>

		<!-- Relacion 1 a N: un Festival tiene muchas UnidadVenta habilitadas (Set,
		     segun el diagrama). inverse="true" porque quien manda es el many-to-one
		     del lado UnidadVenta. access="field" porque Festival.java solo tiene
		     getUnidades(), sin setter (el Set se crea vacio en el constructor y
		     Hibernate lo completa escribiendo el campo directamente). -->
		<set name="unidades" inverse="true" access="field" lazy="true" fetch="select">
			<key column="id_festival" not-null="true"/>
			<one-to-many class="modelo.UnidadVenta"/>
		</set>
	</class>
</hibernate-mapping>
